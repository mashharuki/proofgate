{
  "name": "@proofgate-cdk/extractor",
  "version": "1.2.1",
  "description": "Fail-closed CloudFormation IAM extractor for ProofGate.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashharuki/proofgate.git",
    "directory": "packages/extractor"
  },
  "homepage": "https://github.com/mashharuki/proofgate#readme",
  "bugs": {
    "url": "https://github.com/mashharuki/proofgate/issues"
  },
  "keywords": [
    "aws",
    "cloudformation",
    "iam",
    "cdk",
    "security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofgate-cdk/model": "workspace:^"
  }
}
