{
  "name": "proofgate",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "knip": "knip",
    "jscpd": "jscpd .",
    "pack:check": "node scripts/check-packages.mjs",
    "quality": "pnpm biome:check && pnpm knip && pnpm jscpd",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "synth": "pnpm --filter @proofgate/safe-app synth && pnpm --filter @proofgate/vulnerable-app synth",
    "verify:demo": "pnpm --filter @proofgate/safe-app synth:proofgate && pnpm --filter @proofgate/vulnerable-app synth:proofgate",
    "lean:build": "node scripts/run-lean.mjs build"
  },
  "devDependencies": {
    "@proofgate/core": "workspace:*",
    "@proofgate/cdk-plugin": "workspace:*",
    "@proofgate/extractor": "workspace:*",
    "@proofgate/model": "workspace:*",
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
