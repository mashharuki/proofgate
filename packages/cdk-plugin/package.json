{
  "name": "@proofgate-cdk/cdk-plugin",
  "version": "1.0.0",
  "description": "Lean-powered AWS CDK policy validation plugin for application-specific IAM safety rules.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lean/lean-toolchain",
    "lean/lakefile.toml",
    "lean/lake-manifest.json",
    "lean/ProofGate.lean",
    "lean/ProofGate/**/*.lean",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashharuki/proofgate.git",
    "directory": "packages/cdk-plugin"
  },
  "homepage": "https://github.com/mashharuki/proofgate#readme",
  "bugs": {
    "url": "https://github.com/mashharuki/proofgate/issues"
  },
  "keywords": [
    "aws",
    "cdk",
    "iam",
    "lean",
    "formal-verification",
    "security"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@proofgate-cdk/core": "workspace:^",
    "@proofgate-cdk/extractor": "workspace:^",
    "@proofgate-cdk/model": "workspace:^"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.277.0"
  },
  "devDependencies": {
    "aws-cdk-lib": "2.277.0"
  }
}
