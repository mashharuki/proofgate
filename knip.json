{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["lake"],
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["tests/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "examples/*": {
      "entry": ["src/app.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/real-stacks": {
      "entry": ["src/app.ts", "src/runner.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/trial-app": {
      "entry": ["src/app.ts", "src/probe.ts", "src/run-variants.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "scripts/*.mjs"]
    }
  }
}
